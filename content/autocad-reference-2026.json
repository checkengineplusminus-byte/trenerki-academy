  "walkthroughs": [
    {
      "id": "select",
      "name": "Zaznaczanie i MOVE całej grupy",
      "steps": [
        "Kliknij pierwszą linię, następnie kolejne. Shift + kliknięcie usuwa element z zaznaczenia.",
        "Przeciągnij okno z lewej do prawej: obiekty muszą być całkowicie wewnątrz. Z prawej do lewej: wystarczy przecięcie okna.",
        "Ctrl+A zaznacza dostępne obiekty. Wpisz MOVE, wybierz punkt bazowy 0,0 i cel @2000,0.",
        "Sprawdź, czy wszystkie elementy zmieniły położenie o ten sam wektor bez zmiany wymiarów."
      ],
      "result": "Wszystkie wybrane obiekty zachowują swoje wzajemne odległości i wymiary.",
      "mistake": "Pojedynczy uchwyt (grip) może rozciągnąć geometrię; MOVE przenosi cały zbiór.",
      "docs": "https://help.autodesk.com/cloudhelp/2026/ENU/AutoCAD-Core/files/GUID-DD2A36B6-1196-4205-9A07-32056292F0B5.htm"
    },
    {
      "id": "scale",
      "name": "SCALE obiektu a skala rzutni",
      "steps": [
        "W Model Space rysuj w rzeczywistych jednostkach (np. 4000 oznacza 4000 mm).",
        "Aby zmienić rzeczywistą wielkość obiektów, zaznacz je, wpisz SCALE, podaj bazę i współczynnik, np. 2.",
        "Aby tylko pokazać model na papierze w skali 1:50, przejdź do Layout, wybierz ramkę rzutni i Properties → Standard Scale → 1:50.",
        "Sprawdź: 5000 mm / 50 = 100 mm na papierze. Zablokuj rzutnię i skontroluj PDF."
      ],
      "result": "SCALE zmienia geometrię; Viewport Scale zmienia tylko prezentację na papierze.",
      "mistake": "Nie pomniejszaj modelu przez SCALE, aby zmieścił się na kartce.",
      "docs": "https://help.autodesk.com/cloudhelp/2026/ENU/AutoCAD-Core/files/GUID-9929178F-64E4-4B76-BDE2-00BFDAEFC8B6.htm"
    },
    {
      "id": "font",
      "name": "Czcionka, TEXT, MTEXT, STYLE",
      "steps": [
        "Wpisz STYLE i utwórz styl np. OPIS_2_5. Wybierz font TrueType lub SHX oraz wysokość.",
        "Wpisz MTEXT, wskaż obszar tekstu, wpisz opis. Możesz zmienić styl, wysokość, pogrubienie i wyrównanie.",
        "Jeżeli tekst ma mieć np. 2,5 mm na papierze w skali 1:50, użyj stylu anotacyjnego z Paper Text Height 2.5 albo odpowiednio skonfigurowanej wysokości w modelu.",
        "Otwórz Properties (Ctrl+1), sprawdź Text Style, Text Height oraz skale anotacyjne przed wydrukiem."
      ],
      "result": "Opis ma czytelny font i wysokość odpowiednią do docelowego wydruku.",
      "mistake": "Zmiana czcionki tylko w edytorze pojedynczego MTEXT nie musi zmienić stylu całego projektu.",
      "docs": "https://help.autodesk.com/cloudhelp/2026/ENU/AutoCAD-Core/files/GUID-1ED81E98-6463-4574-875F-183C8280C4AC.htm"
    },
    {
      "id": "osnap",
      "name": "OSNAP — dokładne punkty i tryby",
      "steps": [
        "Naciśnij F3, aby włączyć OSNAP. Otwórz Drafting Settings → Object Snap.",
        "Wybierz Endpoint (koniec), Midpoint (środek odcinka), Center (środek okręgu), Intersection (przecięcie) i inne potrzebne tryby.",
        "Uruchom LINE i przesuń kursor do charakterystycznego punktu, obserwuj marker i podpis przed kliknięciem.",
        "Przez Shift + prawy przycisk myszy możesz jednorazowo wskazać inny rodzaj przyciągania."
      ],
      "result": "Nowe linie zaczynają się w faktycznych punktach geometrii, bez przypadkowych szczelin.",
      "mistake": "F7 włącza siatkę, F9 skok siatki, F3 OSNAP, F8 ORTHO — to różne funkcje.",
      "docs": "https://help.autodesk.com/cloudhelp/2026/ENU/AutoCAD-MAC-Core/files/GUID-06D81B23-B171-4F33-920B-4609E22DD9.htm"
    },
    {
      "id": "units",
      "name": "Jednostki, warstwy i właściwości",
      "steps": [
        "Wpisz UNITS, sprawdź format i jednostki wstawiania. Zweryfikuj rzeczywisty wymiar przez DIST.",
        "Otwórz LAYER: przygotuj OBRYS, OSIE, WYMIARY, przypisz kolory ByLayer.",
        "Wybierz obiekt, Ctrl+1 → Properties; sprawdź warstwę, kolor, współrzędne, długość i typ.",
        "Wyłącz warstwę OSIE i włącz ponownie. Zobacz, że obiekty zostały w pliku."
      ],
      "result": "Rysunek ma kontrolowane jednostki, warstwy i właściwości bez przypadkowego nadpisywania kolorów.",
      "mistake": "Ustawienie milimetrów w UNITS nie skaluje automatycznie starego DWG.",
      "docs": "https://help.autodesk.com/view/ACD/2026/ENU/"
    },
    {
      "id": "dimensions",
      "name": "Wymiarowanie i czytelny PDF",
      "steps": [
        "Użyj DIMLINEAR lub DIMALIGNED do wskazania rzeczywistych punktów modelu.",
        "W DIMSTYLE ustaw wysokości tekstu, strzałki, jednostki, precyzję i skalę anotacji.",
        "Sprawdź niezależnie przez DIST, czy wymiar odpowiada geometrii i czy nie jest nadpisany tekstem.",
        "Ustaw Layout, skalę rzutni i PLOT, wyeksportuj PDF; po eksporcie otwórz go ponownie."
      ],
      "result": "PDF i DWG zawierają zgodne wartości wymiarów w prawidłowej rewizji.",
      "mistake": "Ręczne wpisanie liczby 1000 na wymiarze nie naprawia błędnego odcinka 975 mm.",
      "docs": "https://help.autodesk.com/view/ACD/2026/ENU/"
    },
    {
      "id": "blocks",
      "name": "Bloki, atrybuty i zewnętrzne rysunki",
      "steps": [
        "Narysuj symbol i użyj BLOCK, nadaj mu nazwę oraz punkt bazowy.",
        "Przez INSERT wstaw kilka egzemplarzy; sprawdź liczbę bloków i ich właściwości.",
        "Dołącz zewnętrzny plik przez XREF. Sprawdź ścieżkę względną i dostępność podkładu.",
        "Wykonaj ETRANSMIT, rozpakuj kopię w innym folderze i sprawdź komplet zależności."
      ],
      "result": "Dokumentacja otwiera się u odbiorcy i zachowuje bloki, atrybuty oraz odnośniki.",
      "mistake": "Wstawienie XREF nie kopiuje całego pliku DWG do projektu głównego.",
      "docs": "https://help.autodesk.com/view/ACD/2026/ENU/"
    },
    {
      "id": "shortcuts",
      "name": "Aliasy, skróty i personalizacja",
      "steps": [
        "W AutoCAD 2026 alias polecenia wpisujesz w wierszu poleceń (np. L dla LINE, M dla MOVE).",
        "Skróty klawiaturowe (np. Ctrl+S, Ctrl+1, F3) są konfigurowane osobno w CUIx.",
        "Otwórz Manage → CUI, aby zobaczyć i zmienić skróty; aliasy przechowuje acad.pgp.",
        "Po zmianie sprawdź działanie aliasu na rysunku ćwiczebnym i zapisz własną listę."
      ],
      "result": "Potrafisz odróżnić tekstowy alias komendy od kombinacji klawiszy i sprawdzić zmiany konfiguracji.",
      "mistake": "Nie zakładaj, że aliasy i klawisze są identyczne w każdym profilu AutoCAD.",
      "docs": "https://help.autodesk.com/cloudhelp/2026/ENU/AutoCAD-LT-DidYouKnow/files/GUID-D2B4BF16-B1F7-4EF2-89AF-88ACE85FAD73.htm"
    }
  ],
